# 环境变量配置示例
# 将此文件复制为 .env 并填写实际值
# 部署到帽子云时，在平台的环境变量设置中添加这些值

# AI API配置
API_URL=https://147ai.com
API_KEY=your-api-key-here
MODEL=gpt-image-2-client

# TOS配置
TOS_REGION=cn-guangzhou
TOS_ENDPOINT=tos-cn-guangzhou.volces.com
TOS_BUCKET=your-bucket-name
TOS_ACCESS_KEY=your-access-key-here
TOS_SECRET_KEY=your-secret-key-here